{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "M130a Scan",
  "version": "0.1.0",
  "identifier": "ro.micovi.m130a-scan",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": { "script": "bun run build", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "M130a Scan",
        "width": 900,
        "height": 640,
        "minWidth": 560,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' page: http://page.localhost; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "Scan multi-page documents from the HP M130a into one PDF",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
