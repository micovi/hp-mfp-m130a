{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the scan window may do: the app's own commands, Tauri's core defaults (events and paths) and the save and ask dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-ask",
    "allow-printer-connected",
    "allow-scan-page",
    "allow-cancel-scan",
    "allow-delete-page",
    "allow-reorder-pages",
    "allow-save-pdf",
    "allow-has-unsaved-pages",
    "allow-quit"
  ]
}
